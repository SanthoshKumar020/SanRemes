# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=sanremes
SANREMES_BIND_ADDRESS=127.0.0.1
SANREMES_HTTP_PORT=8080
# Leave empty to use http://localhost:${SANREMES_HTTP_PORT:-8080}.
SANREMES_PUBLIC_URL=
# Leave empty to inherit SANREMES_PUBLIC_URL.
SANREMES_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set SANREMES_PUBLIC_URL to https:// followed by the same hostname.
# Requires SANREMES_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy,
# or a bind address others can reach plus SANREMES_TRUSTED_PROXY_CIDRS.
SANREMES_HTTPS_HOST=
# Name the peers that may claim the HTTPS hostname (CIDRs, space separated).
# Required when SANREMES_HTTPS_HOST is set with any bind address but 127.0.0.1.
# Empty keeps the default: only the host itself can reach a loopback bind.
SANREMES_TRUSTED_PROXY_CIDRS=
SANREMES_BASE_IMAGE=ghcr.io/milind-soni/openmausbot:latest
SANREMES_LOCAL_IMAGE=sanremes-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
SANREMES_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
SANREMES_DATA_EXTERNAL=false
